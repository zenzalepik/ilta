<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Desain Kreatif - Jasa Desain Grafis</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Anton&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Montserrat', sans-serif; }
    .heading { font-family: 'Anton', sans-serif; letter-spacing: 1px; }
  </style>
</head>

<body class="bg-gray-50 text-gray-800">

<!-- HERO -->
<section class="bg-white py-16">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">

    <!-- LEFT -->
    <div>
      <p class="text-sm font-semibold text-blue-900">DESAIN KREATIF</p>

      <h1 class="heading text-6xl leading-tight mt-4">
        JASA <span class="text-yellow-500">DESAIN</span><br/>GRAFIS
      </h1>

      <p class="mt-4 text-gray-600">
        Desain Profesional, Bisnis Makin Berkualitas! Kami membantu UMKM, startup, dan bisnis Anda tampil lebih profesional dengan desain menarik, kreatif, dan tepat sasaran.
      </p>

      <a href="#kontak" class="inline-block mt-6 bg-yellow-500 hover:bg-yellow-600 text-white px-6 py-3 rounded-lg font-semibold shadow">
        KONSULTASI GRATIS
      </a>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="relative">
      <img src="https://images.unsplash.com/photo-1559028012-481c04fa702d?q=80&w=1200" class="rounded-xl shadow-xl" />

      <!-- Badge -->
      <div class="absolute bottom-4 right-4 bg-blue-900 text-white px-5 py-3 rounded-full text-center shadow-lg">
        <p class="text-lg font-bold">100%</p>
        <p class="text-xs">ORIGINAL</p>
      </div>
    </div>

  </div>
</section>

<!-- LAYANAN -->
<section class="py-16 bg-gray-100">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-10">Layanan Kami</h2>

    <div class="grid md:grid-cols-4 gap-6">

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" class="w-12 mb-4">
        <h3 class="font-bold">Desain Logo</h3>
        <p class="text-sm">Logo unik & berkesan untuk identitas bisnis.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/1828/1828919.png" class="w-12 mb-4">
        <h3 class="font-bold">Konten Sosial Media</h3>
        <p class="text-sm">Konten menarik untuk semua platform.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/2991/2991108.png" class="w-12 mb-4">
        <h3 class="font-bold">Brosur & Flyer</h3>
        <p class="text-sm">Media promosi cetak profesional.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/1040/1040230.png" class="w-12 mb-4">
        <h3 class="font-bold">Kemasan Produk</h3>
        <p class="text-sm">Kemasan kreatif dan menarik.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/1828/1828970.png" class="w-12 mb-4">
        <h3 class="font-bold">Banner & Spanduk</h3>
        <p class="text-sm">Promosi visual yang efektif.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135755.png" class="w-12 mb-4">
        <h3 class="font-bold">Presentasi & Company Profile</h3>
        <p class="text-sm">Tampilan bisnis lebih profesional.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/892/892458.png" class="w-12 mb-4">
        <h3 class="font-bold">Merchandise & Kaos</h3>
        <p class="text-sm">Custom desain kebutuhan brand.</p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <img src="https://cdn-icons-png.flaticon.com/512/1828/1828843.png" class="w-12 mb-4">
        <h3 class="font-bold">Dan Lain-lain</h3>
        <p class="text-sm">Kebutuhan desain lainnya siap kami bantu.</p>
      </div>

    </div>
  </div>
</section>

<!-- PORTFOLIO -->
<section class="py-16">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-10">Portofolio Kami</h2>

    <div class="grid md:grid-cols-3 gap-6">

      <img src="https://images.unsplash.com/photo-1600891964599-f61ba0e24092" class="rounded-xl shadow">
      <img src="https://images.unsplash.com/photo-1542838132-92c53300491e" class="rounded-xl shadow">
      <img src="https://images.unsplash.com/photo-1556740749-887f6717d7e4" class="rounded-xl shadow">
      <img src="https://images.unsplash.com/photo-1529336953121-ad5a0d43d0d2" class="rounded-xl shadow">
      <img src="https://images.unsplash.com/photo-1555529669-e69e7aa0ba9a" class="rounded-xl shadow">
      <img src="https://images.unsplash.com/photo-1503602642458-232111445657" class="rounded-xl shadow">

    </div>
  </div>
</section>

<!-- KEUNGGULAN -->
<section class="bg-gray-100 py-16">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-10">Kenapa Pilih Kami?</h2>

    <div class="grid md:grid-cols-4 gap-6 text-center">
      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="font-bold">100% Original</h3>
        <p class="text-sm">Bukan template pasaran</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="font-bold">Tepat Sasaran</h3>
        <p class="text-sm">Sesuai kebutuhan bisnis</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="font-bold">Cepat & Responsif</h3>
        <p class="text-sm">Fast response & pengerjaan</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow">
        <h3 class="font-bold">Harga Bersahabat</h3>
        <p class="text-sm">Kualitas terbaik</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-blue-900 text-white py-16 text-center">
  <h2 class="text-3xl font-bold">Wujudkan Ide Anda Sekarang</h2>
  <a href="#kontak" class="inline-block mt-6 bg-yellow-500 px-8 py-3 rounded-lg font-semibold">
    Konsultasi Gratis
  </a>
</section>

<!-- KONTAK -->
<section id="kontak" class="py-16 text-center">
  <h2 class="text-3xl font-bold mb-6">Hubungi Kami</h2>
  <p>📞 0812 3456 7890</p>
  <p>📷 @desain.kreatif</p>
  <p>✉️ halo@desainkreatif.id</p>
  <p>📍 Melayani Seluruh Indonesia</p>
</section>

<!-- FOOTER -->
<footer class="bg-gray-900 text-white py-6 text-center">
  <p>Desain Kreatif - Solusi Visual untuk Bisnis Anda</p>
</footer>

</body>
</html>